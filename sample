
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Jerome & Jessa | Wedding Invitation</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Great+Vibes&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
:root {
  --ivory:#fcf9f3;
  --cream:#eee3d2;
  --champagne:#c8ad82;
  --gold:#a88959;
  --brown:#594938;
  --dark:#392f27;
}
*{box-sizing:border-box}
body{
  margin:0;background:var(--ivory);color:var(--brown);
  font-family:Montserrat,sans-serif;text-align:center;
}
button{font:inherit;cursor:pointer}
.script{font-family:"Great Vibes",cursive;color:var(--gold)}
.serif{font-family:"Cormorant Garamond",serif}
.eyebrow{font-size:10px;letter-spacing:4px;text-transform:uppercase;color:var(--gold);line-height:2}
.divider{height:1px;width:65px;background:var(--champagne);margin:24px auto}
.bodycopy{font-family:"Cormorant Garamond",serif;font-size:22px;line-height:1.6}
#opening{
  height:100vh;min-height:600px;position:relative;overflow:hidden;
  display:flex;align-items:center;justify-content:center;
  background:radial-gradient(ellipse,#fffdf8,#e9dcc7);
}
.curtain{
  position:absolute;top:0;bottom:0;width:52%;z-index:5;
  background:repeating-linear-gradient(90deg,#9c7956 0px,#c5a77f 18px,#e0c9a6 34px,#a98761 50px);
  box-shadow:inset 0 0 35px #5e442d66;
  transition:transform 2s cubic-bezier(.75,0,.2,1);
}
.curtain.left{left:0;border-right:4px solid #d9bf98}
.curtain.right{right:0;border-left:4px solid #d9bf98}
#opening.open .curtain.left{transform:translateX(-105%)}
#opening.open .curtain.right{transform:translateX(105%)}
.opening-content{
  position:relative;z-index:2;width:min(430px,88vw);
  padding:35px 20px;background:#fffdf8e8;
  border:1px solid var(--champagne);
  box-shadow:0 15px 50px #60482a22;
}
.opening-content:before{
  content:"";position:absolute;inset:7px;border:1px solid #d9c6a5;pointer-events:none;
}
.candle-row{display:flex;justify-content:center;gap:55px;margin:15px 0 25px}
.candle{width:13px;height:58px;background:linear-gradient(90deg,#d8c4a2,#fff8e9,#d2bd99);position:relative;border-radius:4px 4px 2px 2px;box-shadow:0 0 20px #d9ae6480}
.flame{position:absolute;top:-17px;left:3px;width:8px;height:15px;border-radius:80% 10% 80% 10%;background:#f8bd54;transform:rotate(45deg);box-shadow:0 0 15px #f4b74a;animation:flicker .8s infinite alternate}
@keyframes flicker{to{transform:rotate(35deg) scale(.8);opacity:.7}}
.wax{
  border:0;border-radius:50%;width:72px;height:72px;
  color:#fff8e9;background:radial-gradient(circle at 35% 30%,#c5a779,#876642);
  box-shadow:0 4px 12px #4b321f55,inset 0 0 0 2px #e2c99c;
  font-family:"Cormorant Garamond",serif;font-size:22px;
  position:relative;z-index:7;
}
.wax:hover{transform:scale(1.08)}
.tap{font-size:9px;letter-spacing:3px;color:var(--gold);margin-top:18px;animation:pulse 1.6s infinite}
@keyframes pulse{50%{opacity:.4}}
#opening.open .opening-content{animation:fadeout 1.4s 1s forwards}
@keyframes fadeout{to{opacity:0;transform:scale(1.08)}}
#site{display:none;animation:appear 1.2s}
@keyframes appear{from{opacity:0}to{opacity:1}}
.page{display:none;min-height:85vh;padding:55px 18px 30px;align-items:center;justify-content:center}
.page.active{display:flex}
.frame{
  width:min(680px,100%);padding:42px 22px;
  background:#fffdf9;border:1px solid #d8c5a5;
  outline:1px solid #d8c5a566;outline-offset:6px;
  margin:auto;
}
.frame:before,.frame:after{content:"✧";display:block;color:var(--champagne);font-size:22px;margin:8px}
.script{font-size:clamp(42px,9vw,65px);margin:15px 0}
.names{font-family:"Cormorant Garamond",serif;font-size:clamp(38px,9vw,62px);line-height:1.15;color:var(--dark)}
.amp{font-family:"Great Vibes",cursive;color:var(--champagne);font-size:42px}
.date{font-family:"Cormorant Garamond",serif;font-size:36px;color:var(--gold);margin:15px}
.time{font-size:11px;letter-spacing:3px;margin:15px}
.countdown{display:flex;justify-content:center;gap:9px;flex-wrap:wrap;margin:28px auto}
.countbox{background:#f8f3ea;border:1px solid #e4d6bf;padding:12px 9px;min-width:68px}
.countbox strong{display:block;font:30px "Cormorant Garamond",serif;color:var(--gold)}
.countbox span{font-size:8px;letter-spacing:1px}
.nav{display:flex;justify-content:center;align-items:center;gap:17px;margin:25px auto}
.nav button,.goldbtn{
  background:transparent;border:1px solid var(--champagne);
  padding:12px 20px;color:var(--brown);font-size:10px;letter-spacing:2px
}
.nav button:hover,.goldbtn:hover{background:var(--champagne);color:white}
#pageNo{font-size:10px;color:var(--gold);letter-spacing:2px}
.note{font-size:10px;line-height:1.8;color:#8b7b67}
a{color:var(--gold)}
/* Outfit inspiration */
.outfit-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin:20px auto;max-width:520px}
.outfit-card{background:#faf6ef;border:1px solid #e8ddcc;padding:12px 6px 14px}
.outfit-card svg{width:100%;height:155px;display:block}
.outfit-card b{font:17px "Cormorant Garamond",serif;color:var(--brown)}
.outfit-card small{display:block;font-size:9px;color:#8d7b65;margin-top:4px}
.palette-title{font:25px "Cormorant Garamond",serif;color:var(--gold);margin:20px 0 5px}
form{max-width:390px;margin:25px auto;text-align:left}
form label{display:block;font-size:10px;letter-spacing:1px;margin:14px 0 7px}
form input,form select,form textarea{width:100%;padding:12px;border:1px solid #dfd1ba;background:#fffefa;color:var(--brown)}
form button{width:100%;margin-top:20px}
@media(max-width:450px){
 .frame{padding:32px 14px}
 .outfit-grid{gap:9px}
 .outfit-card svg{height:125px}
 .bodycopy{font-size:20px}
}
</style>
</head>
