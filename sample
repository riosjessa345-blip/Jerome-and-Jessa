<script>
function openCurtains(){
 const opening=document.getElementById('opening');
 opening.classList.add('open');
 setTimeout(()=>{
  opening.style.display='none';
  document.getElementById('site').style.display='block';
  showPage(0);
 },2300);
}
let current=0;
const pages=document.querySelectorAll('.page');
function showPage(n){
 current=Math.max(0,Math.min(n,pages.length-1));
 pages.forEach((p,i)=>p.classList.toggle('active',i===current));
 document.getElementById('pageNo').textContent=
  String(current+1).padStart(2,'0')+' / '+String(pages.length).padStart(2,'0');
 document.getElementById('prev').style.visibility=current===0?'hidden':'visible';
 document.getElementById('next').textContent=current===pages.length-1?'BACK TO START':'NEXT';
 window.scrollTo({top:0,behavior:'smooth'});
}
function move(d){
 if(current===pages.length-1 && d===1)showPage(0);
 else showPage(current+d);
}
const wedding=new Date('2026-11-30T15:00:00+08:00').getTime();
function countdown(){
 const diff=wedding-Date.now();
 if(diff<=0){
  document.getElementById('countdown').innerHTML='Today is our special day! ♡';
  return;
 }
 document.getElementById('days').textContent=Math.floor(diff/86400000);
 document.getElementById('hours').textContent=Math.floor(diff/3600000)%24;
 document.getElementById('minutes').textContent=Math.floor(diff/60000)%60;
 document.getElementById('seconds').textContent=Math.floor(diff/1000)%60;
}
countdown();setInterval(countdown,1000);

/* RSVP email: replace with your own email address */
document.getElementById('rsvp').addEventListener('submit',function(e){
 e.preventDefault();
 const email='YOUR_EMAIL@example.com';
 const subject=encodeURIComponent('Wedding RSVP - Jerome & Jessa');
 const body=encodeURIComponent(
  'Name: '+document.getElementById('guest').value+
  '\nAttendance: '+document.getElementById('attendance').value+
  '\nGuests: '+document.getElementById('number').value+
  '\nMessage: '+document.getElementById('message').value
 );
 window.location.href='mailto:'+email+'?subject='+subject+'&body='+body;
});
</script>
